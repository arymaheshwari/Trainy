{
  "expo": {
    "name": "HealthApp",
    "slug": "HealthApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E14",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0E0E14",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0E0E14"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can scan a nutrition label.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can scan a nutrition label."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can scan barcodes."
        }
      ]
    ]
  }
}
