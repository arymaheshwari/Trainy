# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# These EXPO_PUBLIC_* vars are bundled into the client app at build time,
# so only put values here that are safe to ship to devices (public/anon keys).
# Server-only secrets (e.g. GEMINI_API_KEY) live in Supabase, not here:
#   supabase secrets set GEMINI_API_KEY=<your Google AI Studio key>

# USDA FoodData Central — free key: https://fdc.nal.usda.gov/api-key-signup.html
# Falls back to USDA's shared DEMO_KEY (heavily rate-limited) if unset.
EXPO_PUBLIC_USDA_API_KEY=

# Supabase project URL and anon (public) key — Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
